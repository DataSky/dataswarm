# DataSwarm local runtime
DATASWARM_DATA_DIR=../../data
DATASWARM_WORKSPACE_ROOT=../..

# Use real model providers by default.
# Set DATASWARM_MOCK_MODEL=1 only when you explicitly want local mock streaming.

# DMXAPI OpenAI-compatible provider.
DMX_BASE_URL=https://www.dmxapi.cn/v1
DMX_API_KEY=

# DeepSeek sandbox provider, used from M3 onward.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# Sandbox and web research providers.
# Real sandbox is the default execution path. Set `DATASWARM_SANDBOX_PROVIDER=mock` only for explicit offline mode.
DATASWARM_SANDBOX_PROVIDER=e2b
DATASWARM_SANDBOX_AGENT_MODEL=real
E2B_API_KEY=
TAVILY_API_KEY=
