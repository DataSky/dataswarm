{
  "name": "dataswarm",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev:tunnel",
    "build": "npm --prefix apps/web run build",
    "lint": "npm --prefix apps/web run lint",
    "typecheck": "npm --prefix apps/web run typecheck",
    "check": "npm run typecheck && npm run lint",
    "verify:commit": "npm run check && npm run smoke:sandbox && npm run smoke:swarm-verifier",
    "verify:dry": "node scripts/canonical-verification-runner.mjs --dry-run",
    "verify:audit": "node scripts/canonical-goal-audit.mjs",
    "verify:e2b": "node scripts/canonical-verification-runner.mjs --phase phase4 --only e2b-readiness,e2b-live-receipt,e2b-live-sandbox,e2b-orchestrator-e2e",
    "verify:e2b:strict": "node scripts/canonical-verification-runner.mjs --phase phase4 --only e2b-live-sandbox,e2b-orchestrator-e2e --require-live-e2b",
    "smoke:agentic-v2": "node scripts/agentic-loop-v2-smoke.mjs",
    "smoke:artifact": "node scripts/artifact-quality-smoke.mjs",
    "smoke:sandbox": "node scripts/sandbox-agent-smoke.mjs",
    "smoke:sandbox-v2": "node scripts/sandbox-agent-v2-smoke.mjs",
    "smoke:sandbox-v3": "node scripts/sandbox-agent-v3-smoke.mjs",
    "smoke:sandbox-v3-plus-static": "node scripts/sandbox-agent-v3-plus-static-smoke.mjs",
    "smoke:sandbox-v3-plus-local": "node scripts/sandbox-agent-v3-smoke.mjs",
    "smoke:sandbox-v3-plus-complex": "node scripts/sandbox-agent-v3-plus-complex-benchmark-smoke.mjs",
    "smoke:sandbox-v3-plus": "node scripts/sandbox-agent-v3-plus-static-smoke.mjs && node scripts/sandbox-agent-v3-smoke.mjs && node scripts/sandbox-agent-v3-plus-complex-benchmark-smoke.mjs",
    "smoke:sandbox-v3-real-action": "node scripts/sandbox-agent-v3-real-action-smoke.mjs",
    "smoke:sandbox-v3-plus-real-action": "node scripts/sandbox-agent-v3-real-action-smoke.mjs",
    "smoke:e2b-v3-real-action": "node scripts/e2b-sandbox-v3-real-action-smoke.mjs",
    "smoke:e2b-orchestrator-v3-real-action": "node scripts/e2b-orchestrator-v3-real-action-e2e-smoke.mjs",
    "smoke:e2b-orchestrator-v3-parent-proxy": "DATASWARM_E2B_ORCHESTRATOR_V3_PARENT_PROXY=1 node scripts/e2b-orchestrator-v3-real-action-e2e-smoke.mjs",
    "smoke:e2b-orchestrator-v3-parent-proxy:localtunnel": "DATASWARM_E2B_ORCHESTRATOR_V3_PARENT_PROXY=1 DATASWARM_E2B_ORCHESTRATOR_V3_PARENT_PROXY_AUTOTUNNEL=localtunnel node scripts/e2b-orchestrator-v3-real-action-e2e-smoke.mjs",
    "smoke:e2b-branch-complex-benchmark": "DATASWARM_E2B_ORCHESTRATOR_V3_PARENT_PROXY=1 DATASWARM_E2B_ORCHESTRATOR_V3_COMPLEX_BENCHMARK=1 node scripts/e2b-orchestrator-v3-real-action-e2e-smoke.mjs",
    "smoke:e2b-complex-benchmark-contract": "node scripts/e2b-complex-benchmark-contract-smoke.mjs",
    "smoke:e2b-branch-complex-benchmark:localtunnel": "DATASWARM_E2B_ORCHESTRATOR_V3_PARENT_PROXY=1 DATASWARM_E2B_ORCHESTRATOR_V3_COMPLEX_BENCHMARK=1 DATASWARM_E2B_ORCHESTRATOR_V3_PARENT_PROXY_AUTOTUNNEL=localtunnel node scripts/e2b-orchestrator-v3-real-action-e2e-smoke.mjs",
    "smoke:sandbox-tool-proxy": "node scripts/sandbox-tool-proxy-e2e-smoke.mjs",
    "smoke:swarm-verifier": "node scripts/swarm-verifier-smoke.mjs",
    "smoke:swarm-parallel": "node scripts/swarm-parallel-execution-smoke.mjs",
    "smoke:swarm-parallel-e2e": "node scripts/swarm-parallel-e2e-smoke.mjs",
    "smoke:swarm-image": "node scripts/swarm-image-artifact-e2e-smoke.mjs",
    "smoke:tool-contract": "node scripts/tool-event-contract-e2e-smoke.mjs",
    "smoke:skills": "node scripts/skills-v2-smoke.mjs",
    "smoke:skills-e2e": "node scripts/skills-observation-e2e-smoke.mjs",
    "smoke:frontend-design-skill": "DATASWARM_SKILL_OBSERVATION_TARGET=frontend-design node scripts/skills-observation-e2e-smoke.mjs",
    "smoke:swarm": "node scripts/swarm-action-plan-smoke.mjs && node scripts/swarm-reducer-smoke.mjs && node scripts/swarm-verifier-smoke.mjs && node scripts/swarm-parallel-execution-smoke.mjs",
    "smoke:swarm-trace": "node scripts/swarm-trace-ui-smoke.mjs",
    "smoke:self-improvement": "node scripts/self-improvement-async-smoke.mjs && node scripts/self-improvement-lifecycle-smoke.mjs && node scripts/self-improvement-summary-smoke.mjs",
    "smoke:trace-diagnostics": "node scripts/trace-diagnostics-sandbox-smoke.mjs && node scripts/trace-diagnostics-improvements-smoke.mjs && node scripts/trace-diagnostics-runtime-consistency-smoke.mjs && node scripts/trace-diagnostics-ui-smoke.mjs",
    "dev:real": "npm --prefix apps/web run dev:tunnel",
    "dev:local-real": "npm --prefix apps/web run dev:local-real",
    "dev:tunnel": "npm --prefix apps/web run dev:tunnel",
    "dev:mock": "npm --prefix apps/web run dev:mock"
  }
}
